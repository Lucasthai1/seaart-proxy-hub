PORT=8788
HOST=0.0.0.0
NODE_ENV=development

# Auth interna da plataforma (gere com: openssl rand -hex 32)
JWT_SECRET=change-me-now

# SeaArt
SEAART_MODE=sdk
SEAART_EMAIL=
SEAART_PASSWORD=
SEAART_MCP_URL=http://127.0.0.1:8787/mcp
SEAART_TOKEN=

# ComfyUI
COMFY_MODE=cloud
COMFY_API_KEY=
COMFY_CLOUD_BASE=https://cloud.comfy.org/api
COMFY_LOCAL_BASE=http://127.0.0.1:8188

# MCP Gateway (gere com: openssl rand -hex 32)
MCP_REMOTE_MODE=bearer
MCP_BEARER_TOKEN=change-me-mcp-token
MCP_PUBLIC_BASE=https://your-domain.com

# Quota
DEFAULT_FREE_IMAGE_LIMIT=5

# Rate limit
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
